    "severityBands": [
        {
            "id": "no-impact",
            "label": "No/Minimal Impact",
            "min": 0,
            "max": 19,
            "color": "#22c55e",
            "description": "Fibromyalgia has minimal impact on daily life."
        },
        {
            "id": "mild",
            "label": "Mild Impact",
            "min": 20,
            "max": 39,
            "color": "#84cc16",
            "description": "Mild fibromyalgia impact on function and symptoms."
        },
        {
            "id": "moderate",
            "label": "Moderate Impact",
            "min": 40,
            "max": 59,
            "color": "#eab308",
            "description": "Moderate fibromyalgia impact requiring symptom management."
        },
        {
            "id": "severe",
            "label": "Severe Impact",
            "min": 60,
            "max": 79,
            "color": "#f97316",
            "description": "Severe fibromyalgia impact significantly affecting quality of life."
        },
        {
            "id": "very-severe",
            "label": "Very Severe Impact",
            "min": 80,
            "max": 100,
            "color": "#ef4444",
            "description": "Very severe fibromyalgia impact requiring comprehensive clinical intervention."
        }
