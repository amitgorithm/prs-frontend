    "interpretation": {
        "scoringMethod": "FIQR Total = (Function Sum / 3) + (Overall Sum) + (Symptoms Sum / 2). Range: 0-100.",
        "domains": {
            "function": "Physical Function (9 items, ÷3): Max 30 points",
            "overall": "Overall Impact (2 items, ×1): Max 20 points",
            "symptoms": "Symptom Severity (10 items, ÷2): Max 50 points"
        },
        "clinicalNotes": "The FIQR is sensitive to change and can be used to monitor treatment response. A change of 14% or more is considered clinically meaningful. Higher scores indicate greater fibromyalgia impact."
    },

    "references": [
        {
