        "description": "Critical items that warrant immediate clinical attention if endorsed at 2 or higher",
        "action": "Any score ≥2 on these items should trigger clinical review"
    },

    "interpretation": {
        "scoringMethod": "Sum all item scores for total (0-124). Calculate subscale totals separately. Higher scores indicate greater symptom burden.",
        "subscaleInterpretation": "Subscale scores identify specific domains of concern. Elevated subscale scores (>50% of maximum) suggest clinically significant symptoms in that domain.",
        "criticalItemReview": "Immediately review any critical items (suicidal ideation, hallucinations, delusions) scored ≥2.",
        "clinicalUse": "Designed for screening psychiatric comorbidity in neurological patients including those with epilepsy, MS, Parkinson's disease, stroke, and dementia. Not a diagnostic tool but guides further assessment.",
        "minimumClinicallyImportantDifference": "A change of 10 points in total score is generally considered clinically meaningful."
    },

    "references": [
        {
            "citation": "Developed for comprehensive psychiatric screening in neurological populations. Based on established psychiatric screening instruments adapted for neurological conditions.",
            "note": "Composite measure drawing from validated instruments"
        },
