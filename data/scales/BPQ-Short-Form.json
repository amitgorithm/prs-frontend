    "severityBands": [
        {
            "id": "low",
            "label": "Low Body Awareness",
            "range": { "min": 18, "max": 35 },
            "color": "#3b82f6",
            "description": "Lower than average interoceptive awareness."
        },
        {
            "id": "moderate",
            "label": "Moderate Body Awareness",
            "range": { "min": 36, "max": 53 },
            "color": "#22c55e",
